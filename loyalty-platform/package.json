{
  "name": "loyalty-platform",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "db:generate": "pnpm --filter db exec prisma generate",
    "db:migrate": "pnpm --filter db exec prisma migrate dev",
    "db:studio": "pnpm --filter db exec prisma studio"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}
