generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}


model User {
  id           String   @id @default(cuid())
  name         String
  phone        String?  @unique
  email        String?  @unique
  passwordHash String?
  memberCode   String   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  MerchantMembership[]
  transactions Transaction[]        @relation("CustomerTransactions")
  redemptions  Redemption[]
  staffRoles   MerchantStaff[]

  @@map("users")
}

model Merchant {
  id                  String   @id @default(cuid())
  name                String
  industry            String   @default("OTHER")
  logoUrl             String?
  location            String?
  symbol              String   @default("★")

  redemptionTarget    Int      @default(10)
  rewardDescription   String
  rewardType          String   @default("FREE_ITEM")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  earningRules EarningRule[]
  memberships  MerchantMembership[]
  transactions Transaction[]
  redemptions  Redemption[]
  staff        MerchantStaff[]

  @@map("merchants")
}

model EarningRule {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  type              String  @default("SPEND_THRESHOLD")
  thresholdAmount   Int
  starsPerThreshold Int     @default(1)
  currency          String  @default("KES")
  config            String  @default("{}") // 
  isActive          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([merchantId, isActive])
  @@map("earning_rules")
}

model MerchantStaff {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role      String   @default("STAFF")
  createdAt DateTime @default(now())

  @@unique([merchantId, userId])
  @@map("merchant_staff")
}

model MerchantMembership {
  id         String   @id @default(cuid())

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  currentStars  Int      @default(0)
  lifetimeStars Int      @default(0)
  joinedAt      DateTime @default(now())

  @@unique([userId, merchantId])
  @@map("merchant_memberships")
}

model Transaction {
  id         String   @id @default(cuid())

  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  userId     String
  user       User     @relation("CustomerTransactions", fields: [userId], references: [id], onDelete: Cascade)

  amount     Int      // 👈 FIXED to match 'amount' tracking expected by API code 
  starsAwarded Int @default(0)

  loggedBy String?

  createdAt DateTime @default(now())

  @@index([merchantId, createdAt])
  @@index([merchantId, userId])

  @@map("transactions")
}

model Redemption {
  id         String   @id @default(cuid())

  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  starsUsed         Int
  rewardDescription String
  status            String   @default("PENDING")

  code String @unique

  createdAt   DateTime  @default(now())
  fulfilledAt DateTime?
  fulfilledBy String?

  @@index([merchantId, status])
  @@index([merchantId, userId])

  @@map("redemptions")
}
